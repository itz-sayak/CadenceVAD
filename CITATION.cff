        given-names: "Himanshu"
    repository-code: "https://github.com/oss-codes/flashvad"
    license: "MIT AND CC-BY-4.0"
    notes: >-
      CadenceVAD is derived from FlashVAD. The retained v0.1 reference checkpoint
      is the FlashVAD v0.1 checkpoint, redistributed under CC BY 4.0.
